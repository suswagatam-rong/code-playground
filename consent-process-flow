@startuml
title Customer CERSAI Consent API - Business Process Flow

start

:CRM submits CERSAI consent request;

:Route request through EIS (DMZ);

:Authenticate request;

if (Authentication successful?) then (Yes)

    :Apply adaptive request admission control;

    if (Concurrent request limit /\nqueue saturation reached?) then (Yes)
        :Return HTTP 429;
        :Code = REQUEST_THROTTLED;
        stop
    endif

    :Validate request payload;

    if (Request valid?) then (Yes)

        :Extract transactionReference,\ncifNumber, mobileNumber,\nconsent and consentTimestamp;

        :Resolve customer using CIF\nagainst Oracle RAC;

        if (Database operation successful?) then (Yes)

            if (CIF found?) then (Yes)

                :Verify supplied mobile number\nagainst registered mobile number;

                if (Mobile number matches?) then (Yes)

                    :Retrieve SMS delivery timestamp;

                    :Calculate consent expiry timestamp\n= SMS delivery timestamp + 3 days;

                    if (Consent within TAT?) then (Yes)

                        :Check transactionReference;

                        if (Transaction already processed?) then (Yes)

                            :Return previously processed result;
                            :Code = DUPLICATE_TRANSACTION;
                            stop
                        endif

                        :Retrieve latest consent status;

                        if (Existing consent?) then (Yes)

                            if (Existing consent = Incoming consent?) then (Yes)

                                :No update required;
                                :Code = CONSENT_ALREADY_RECORDED;

                            else (No)

                                :Insert Consent History;
                                :Update Latest Consent;
                                :Code = CONSENT_UPDATED;

                            endif

                        else (No)

                            :Insert Consent History;
                            :Update Latest Consent;
                            :Code = CONSENT_RECORDED;

                        endif

                        :Commit transaction;

                        :Return standardized SUCCESS response;
                        stop

                    else (No)

                        :Return HTTP 409;
                        :Code = CONSENT_TAT_EXPIRED;
                        :Fresh consent request required;
                        stop

                    endif

                else (No)

                    :Return HTTP 409;
                    :Code = CUSTOMER_DETAILS_MISMATCH;
                    stop

                endif

            else (No)

                :Return HTTP 404;
                :Code = CIF_NOT_FOUND;
                stop

            endif

        else (No)

            :Return HTTP 503;
            :Code = SERVICE_UNAVAILABLE;
            stop

        endif

    else (No)

        :Return HTTP 400;
        :Code = VALIDATION_ERROR;
        stop

    endif

else (No)

    :Return HTTP 401;
    :Code = UNAUTHORIZED;
    stop

endif

@enduml