CREATE TABLE CERSAI_CONSENT (
    CONSENT_ID              NUMBER(19) GENERATED BY DEFAULT AS IDENTITY,
    CIF_NUMBER              VARCHAR2(20 CHAR) NOT NULL,

    LATEST_CONSENT          VARCHAR2(3 CHAR) NOT NULL,
    LATEST_CONSENT_TIME     TIMESTAMP WITH TIME ZONE NOT NULL,

    CREATED_AT              TIMESTAMP WITH TIME ZONE
        DEFAULT SYSTIMESTAMP NOT NULL,

    UPDATED_AT              TIMESTAMP WITH TIME ZONE
        DEFAULT SYSTIMESTAMP NOT NULL,

    CONSTRAINT PK_CERSAI_CONSENT
        PRIMARY KEY (CONSENT_ID),

    CONSTRAINT UK_CERSAI_CONSENT_CIF
        UNIQUE (CIF_NUMBER),

    CONSTRAINT CK_CERSAI_CONSENT_VALUE
        CHECK (LATEST_CONSENT IN ('YES', 'NO'))
);


CREATE TABLE CERSAI_CONSENT_HISTORY (
    CONSENT_HISTORY_ID      NUMBER(19) GENERATED BY DEFAULT AS IDENTITY,

    CONSENT_ID              NUMBER(19) NOT NULL,

    TRANSACTION_REFERENCE   VARCHAR2(100 CHAR) NOT NULL,

    CIF_NUMBER              VARCHAR2(20 CHAR) NOT NULL,
    MOBILE_NUMBER           VARCHAR2(15 CHAR) NOT NULL,

    CONSENT                 VARCHAR2(3 CHAR) NOT NULL,
    CONSENT_TIMESTAMP       TIMESTAMP WITH TIME ZONE NOT NULL,

    AGENT_ID                VARCHAR2(50 CHAR),
    REMARKS                 VARCHAR2(500 CHAR),

    CREATED_AT              TIMESTAMP WITH TIME ZONE
        DEFAULT SYSTIMESTAMP NOT NULL,

    CONSTRAINT PK_CERSAI_CONSENT_HISTORY
        PRIMARY KEY (CONSENT_HISTORY_ID),

    CONSTRAINT UK_CERSAI_CONSENT_TXN_REF
        UNIQUE (TRANSACTION_REFERENCE),

    CONSTRAINT FK_CERSAI_CONSENT_HISTORY
        FOREIGN KEY (CONSENT_ID)
        REFERENCES CERSAI_CONSENT (CONSENT_ID),

    CONSTRAINT CK_CERSAI_CONSENT_HISTORY_VALUE
        CHECK (CONSENT IN ('YES', 'NO'))
);

CREATE INDEX IDX_CERSAI_CONSENT_HISTORY_CIF
    ON CERSAI_CONSENT_HISTORY (CIF_NUMBER);

CREATE INDEX IDX_CERSAI_CONSENT_HISTORY_CIF_TIME
    ON CERSAI_CONSENT_HISTORY (CIF_NUMBER, CONSENT_TIMESTAMP);


ALTER TABLE CERSAI_CUSTOMER_DETAILS
    ADD (
        CERSAI_DOWNLOAD_ELIGIBLE CHAR(1)
            DEFAULT 'Y'
            NOT NULL
    );

ALTER TABLE CERSAI_CUSTOMER_DETAILS
    ADD CONSTRAINT CK_CERSAI_DOWNLOAD_ELIGIBLE
    CHECK (CERSAI_DOWNLOAD_ELIGIBLE IN ('Y', 'N'));


SELECT ...
FROM CERSAI_CUSTOMER_DETAILS
WHERE CERSAI_DOWNLOAD_ELIGIBLE = 'Y'
  AND ...;
